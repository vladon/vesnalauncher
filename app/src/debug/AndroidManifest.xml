<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Test fixture only: the debug build's bindable widget provider. The
             APPWIDGET_UPDATE broadcast is system-protected, so exported is safe. -->
        <receiver
            android:name=".workspace.WidgetFixtureProvider"
            android:exported="true"
            android:label="Vesna widget fixture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fixture_provider_info" />
        </receiver>
    </application>
</manifest>
