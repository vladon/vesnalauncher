<?xml version="1.0" encoding="utf-8"?>
<dev.vladon.vesna.launcher.ui.LauncherDragLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <dev.vladon.vesna.launcher.ui.WorkspaceView
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/workspace_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="96dp"
            android:background="@drawable/workspace_label_backing"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/workspace_empty_hint"
            android:textColor="@color/icon_label_color"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/home_dock_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <dev.vladon.vesna.launcher.ui.DockView
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <dev.vladon.vesna.launcher.ui.HomeControls
            android:id="@+id/home_controls"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_control_target"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/workspace_page_controls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/home_control_gap"
                android:background="@drawable/home_control_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/workspace_previous_page"
                    android:layout_width="@dimen/home_control_target"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_control_states"
                    android:contentDescription="@string/workspace_previous_page"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_workspace_previous_page" />

                <dev.vladon.vesna.launcher.ui.WorkspacePageIndicator
                    android:id="@+id/workspace_page_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/home_control_states"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:minWidth="@dimen/home_control_target"
                    android:tooltipText="@string/workspace_choose_page" />

                <ImageButton
                    android:id="@+id/workspace_next_page"
                    android:layout_width="@dimen/home_control_target"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_control_states"
                    android:contentDescription="@string/workspace_next_page"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_workspace_next_page" />
            </LinearLayout>
        </dev.vladon.vesna.launcher.ui.HomeControls>

        <View
            android:id="@+id/menu_anchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <dev.vladon.vesna.launcher.ui.DrawerView
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</dev.vladon.vesna.launcher.ui.LauncherDragLayer>
