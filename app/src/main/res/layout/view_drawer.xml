<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/drawer_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/home_control_icon_button"
                android:contentDescription="@string/drawer_close"
                android:focusable="true"
                android:padding="0dp"
                android:scaleType="center"
                android:src="@drawable/ic_close_drawer"
                android:tooltipText="@string/drawer_close" />

            <LinearLayout
                android:id="@+id/drawer_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/search_field_background"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/drawer_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="@string/drawer_search_hint"
                    android:imeOptions="actionDone|flagNoFullscreen|flagNoPersonalizedLearning"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:letterSpacing="0.03125"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingVertical="8dp"
                    android:singleLine="true"
                    android:textColor="@color/home_control_on_surface"
                    android:textColorHint="@color/vesna_on_surface_variant"
                    android:textCursorDrawable="@drawable/drawer_search_cursor"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/drawer_clear_search"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/home_control_states"
                    android:contentDescription="@string/drawer_clear_search"
                    android:focusable="true"
                    android:padding="0dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_clear_search"
                    android:tooltipText="@string/drawer_clear_search"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/drawer_no_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/inter_regular"
            android:minHeight="72dp"
            android:paddingHorizontal="24dp"
            android:text="@string/drawer_no_results"
            android:textColor="@color/vesna_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false"
                android:scrollbars="vertical" />

            <dev.vladon.vesna.launcher.ui.DrawerPager
                android:id="@+id/drawer_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false"
                android:visibility="gone" />

            <dev.vladon.vesna.launcher.ui.DrawerFastScroller
                android:id="@+id/drawer_fast_scroller"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:contentDescription="@string/drawer_fast_scroll"
                android:focusable="true"
                android:importantForAccessibility="yes"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/drawer_section_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="48dp"
                android:background="@drawable/drawer_section_indicator"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/home_control_on_surface"
                android:textSize="22sp"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>
</merge>
