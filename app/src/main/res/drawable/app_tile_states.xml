<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/home_control_focus_press">
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="true" android:state_focused="true">
                <inset android:inset="2dp">
                    <shape>
                        <corners android:radius="12dp" />
                        <solid android:color="@color/home_control_surface" />
                        <stroke android:width="2dp" android:color="@color/home_control_secondary" />
                    </shape>
                </inset>
            </item>
            <item android:state_enabled="true" android:state_hovered="true">
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="@color/home_control_hover" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
