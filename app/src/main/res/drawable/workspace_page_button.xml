<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/workspace_page_focus_press">
    <item android:id="@android:id/mask" android:left="4dp" android:top="4dp"
        android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="true" android:state_focused="true">
                <inset android:inset="2dp">
                    <shape android:shape="oval">
                        <solid android:color="@color/workspace_page_focus_press" />
                        <stroke android:width="2dp" android:color="@color/workspace_page_secondary" />
                    </shape>
                </inset>
            </item>
            <item android:state_enabled="true" android:state_hovered="true">
                <inset android:inset="4dp">
                    <shape android:shape="oval">
                        <solid android:color="@color/workspace_page_hover" />
                    </shape>
                </inset>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
